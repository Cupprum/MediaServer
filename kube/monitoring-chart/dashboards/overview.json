    {
      "id": 12,
      "type": "timeseries",
      "title": "Network traffic",
      "datasource": "${datasource}",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 1
          },
          "unit": "bps"
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        { "datasource": "${datasource}", "expr": "rate(node_network_receive_bytes_total{device!~\"lo|veth.*|cni.*|flannel.*|cali.*|docker.*|br-.*\"}[5m]) * 8", "legendFormat": "{{device}} in", "refId": "A" },
        { "datasource": "${datasource}", "expr": "rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|cni.*|flannel.*|cali.*|docker.*|br-.*\"}[5m]) * 8", "legendFormat": "{{device}} out", "refId": "B" }
      ]
    },
