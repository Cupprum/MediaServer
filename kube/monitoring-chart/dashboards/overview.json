          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          },
          "unit": "none",
          "custom": {
            "cellOptions": { "type": "color-text" },
            "inspect": false
          }
        },
        "overrides": []
      },
      "options": {
        "showTypeIcons": false
      },
      "targets": [
        { "datasource": "${datasource}", "expr": "sum by (namespace, pod) (kube_pod_container_status_restarts_total)", "format": "table", "instant": true, "refId": "A" }
